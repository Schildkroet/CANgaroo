// Allow members of the netdev group to configure SocketCAN interfaces
// via `ip link set` without a password prompt.
// CANgaroo brings CAN interfaces down and up (requires CAP_NET_ADMIN) with one
// `pkexec /bin/sh -c <script>` call per measurement start, so that users
// without this rule get a single password prompt for all interfaces.
//
// Only the exact script CANgaroo generates is allowed (see
// SocketCanInterface::applyConfig / flushPendingConfig; change them together
// with this file). The script is matched as a whole, anchored at both ends, and
// every variable part sits inside single quotes with a character class that
// excludes quotes, so nothing else can be smuggled in. Matching on the program
// alone would let netdev members run arbitrary commands as root.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec" ||
        !subject.isInGroup("netdev"))
    {
        return polkit.Result.NOT_HANDLED;
    }

    var prog = action.lookup("program");
    if (prog !== "/bin/sh" && prog !== "/usr/bin/sh")
    {
        return polkit.Result.NOT_HANDLED;
    }

    var cmd = action.lookup("command_line");
    if (typeof cmd !== "string")
    {
        return polkit.Result.NOT_HANDLED;
    }

    var q = function(s) { return "'" + s + "'"; };

    var ip     = q("(?:/usr)?/s?bin/ip");
    var ifname = "[A-Za-z0-9_.:-]{1,15}";
    var num    = q("[0-9]+");
    var frac   = q("[0-9]+\\.[0-9]+");

    var down = ip + " 'link' 'set' " + q(ifname) + " 'down'";
    var up   = ip + " 'link' 'set' " + q(ifname) + " 'up' 'type' 'can'" +
               " 'bitrate' " + num +
               " 'sample-point' " + frac +
               "(?: 'dbitrate' " + num + " 'dsample-point' " + frac + " 'fd' 'on')?" +
               " 'restart-ms' " + num +
               "(?: 'listen-only' '(?:on|off)')?";

    // One interface: down, then the up command with up to three fallbacks.
    var marker = "(?:no-restart|no-listen-only|no-restart,no-listen-only)";
    var iface  = down + "; " +
                 "if " + up + "; then :; " +
                 "(?:elif " + up + "; then echo " + q(ifname + " " + marker) + "; ){0,3}" +
                 "else echo " + q(ifname + " failed") + "; rc=1; fi; ";

    var script = new RegExp("^\\S+ -c rc=0; (?:" + iface + ")+exit \\$rc$");

    if (script.test(cmd))
    {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
